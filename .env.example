# Copy to .env.local. Never commit .env.local.
# Both point at YOUR OWN Neon dev branch (in oi-staging), never production.

# The app role: used by the running site. Created by SQL, cannot bypass RLS.
DATABASE_URL=postgresql://app:PASSWORD@HOST/neondb?sslmode=require

# The migrator (neondb_owner): used only by `pnpm db:migrate` and `pnpm db:seed`.
MIGRATE_DATABASE_URL=postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=require

# local | preview | staging | production. Vercel sets this per environment.
OI_ENV=local

# Signs session cookies. Generate: openssl rand -base64 32. Different per environment.
BETTER_AUTH_SECRET=

# Hosts sign-in may run on (comma list, wildcards ok). Local default covers admin.localhost:3000.
# Vercel: production *.outputinput.co · staging *.outputinput.io · preview *.vercel.app
# OI_AUTH_HOSTS=

# Optional. With both set, sign-in codes are emailed through Resend.
# Without them, codes are logged, and shown on screen outside production.
# RESEND_API_KEY=
# EMAIL_FROM="output/input <sign-in@example.com>"

# Optional, migrate-time only. Creates the first site and its owner if missing.
# Set these on Vercel production once; harmless to leave in place.
# OI_BOOTSTRAP_SITE_SLUG=
# OI_BOOTSTRAP_SITE_NAME=
# OI_BOOTSTRAP_OWNER_EMAIL=

# Pictures (Cloudflare R2). All five or none. Without them, outside production,
# files are kept in .media-local and served by /api/media-local.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=oi-media
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Payments. Output/Input's Stripe platform account (Connect) — test keys on
# staging and previews, live keys on production only. Leave both empty
# locally: checkout then uses test payments and nothing real moves.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
